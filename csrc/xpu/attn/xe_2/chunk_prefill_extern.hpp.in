#define DECLARE_POLICY_DISPATCH_EXTERN(                          \
    POLICY, PAGED, CAUSAL, LOCAL, SINK, LSE)                     \
  extern template void                                           \
  policy_dispatch_impl<POLICY, PAGED, CAUSAL, LOCAL, SINK, LSE>( \
      sycl::queue & queue,                                       \
      CutlassQKType & cuQKType,                                  \
      const chunk_prefill_args_t& args);

// Paged and non-paged kernels support LSE=true for Local=false,Sink=false.
// Total per policy: 10 paged + 10 non-paged = 20 instantiations.

// LSE axis: both true and false.
#define DECLARE_FOR_LSE_BOTH(POLICY, PAGED, CAUSAL, LOCAL, SINK)            \
  DECLARE_POLICY_DISPATCH_EXTERN(POLICY, PAGED, CAUSAL, LOCAL, SINK, false) \
  DECLARE_POLICY_DISPATCH_EXTERN(POLICY, PAGED, CAUSAL, LOCAL, SINK, true)

// LSE axis: only false (all other P/L/S combos)
#define DECLARE_FOR_LSE_FALSE(POLICY, PAGED, CAUSAL, LOCAL, SINK) \
  DECLARE_POLICY_DISPATCH_EXTERN(POLICY, PAGED, CAUSAL, LOCAL, SINK, false)

// Sink axis for LSE=false-only branches.
#define DECLARE_FOR_SINK_FALSEONLY(POLICY, PAGED, CAUSAL, LOCAL) \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, CAUSAL, LOCAL, false)     \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, CAUSAL, LOCAL, true)

#define DECLARE_FOR_LOCAL_FALSEONLY(POLICY, PAGED, CAUSAL) \
  DECLARE_FOR_SINK_FALSEONLY(POLICY, PAGED, CAUSAL, false) \
  DECLARE_FOR_SINK_FALSEONLY(POLICY, PAGED, CAUSAL, true)

#define DECLARE_FOR_CAUSAL_FALSEONLY(POLICY, PAGED) \
  DECLARE_FOR_LOCAL_FALSEONLY(POLICY, PAGED, false) \
  DECLARE_FOR_LOCAL_FALSEONLY(POLICY, PAGED, true)

// Local=F,Sink=F branch (LSE=T/F allowed): Causal axis only.
#define DECLARE_LSE_ALLOWED_BRANCH(POLICY, PAGED)          \
  DECLARE_FOR_LSE_BOTH(POLICY, PAGED, false, false, false) \
  DECLARE_FOR_LSE_BOTH(POLICY, PAGED, true, false, false)

// Local=true or Sink=true: LSE=false only. Causal x Local x Sink (minus
// the all-false case already covered above).
#define DECLARE_LSE_DISABLED_BRANCH(POLICY, PAGED)         \
  /* Causal=F, Local=F, Sink=T */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, false, false, true) \
  /* Causal=F, Local=T, Sink=F */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, false, true, false) \
  /* Causal=F, Local=T, Sink=T */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, false, true, true)  \
  /* Causal=T, Local=F, Sink=T */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, true, false, true)  \
  /* Causal=T, Local=T, Sink=F */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, true, true, false)  \
  /* Causal=T, Local=T, Sink=T */                          \
  DECLARE_FOR_LSE_FALSE(POLICY, PAGED, true, true, true)

#define DECLARE_ALL_BOOL_COMBINATIONS(POLICY) \
  DECLARE_LSE_ALLOWED_BRANCH(POLICY, false)   \
  DECLARE_LSE_DISABLED_BRANCH(POLICY, false)  \
  DECLARE_LSE_ALLOWED_BRANCH(POLICY, true)    \
  DECLARE_LSE_DISABLED_BRANCH(POLICY, true)

CHUNK_POLICY_LIST(DECLARE_ALL_BOOL_COMBINATIONS)

#undef DECLARE_ALL_BOOL_COMBINATIONS
